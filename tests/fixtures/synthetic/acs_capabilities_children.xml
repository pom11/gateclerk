  <currentVerifyMode><opt>face,card,fp,cardOrFaceOrFp</opt></currentVerifyMode>
  <attendanceStatus><opt>undefined,checkIn,checkOut</opt></attendanceStatus>
 </InfoList>
</Capabilities>
