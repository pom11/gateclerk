  <major><opt>0,1,2,3,5</opt></major>
  <minorAlarm><opt>1028,1029,1030</opt></minorAlarm>
  <minorOperation><opt>80,112,113,1024,1025,1029</opt></minorOperation>
  <minorEvent><opt>1,9,21,22,23,75,76,80</opt></minorEvent>
  <employeeNoString><min>0</min><max>32</max></employeeNoString>
 </AcsEventCond>
 <InfoList>
