<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateclerk-agent.plist  EXAMPLE ONLY, NOT A PRODUCT.

  Owner decision, docs/internal/P2-SITE-AGENT.md section 2d: agents run on Linux (see
  gateclerk-agent@.service, the supported deploy target) or Windows (deploy/README.md).
  macOS is the DEVELOPERS' box, so this file exists only so a developer who wants a long
  running agent on a laptop gets the SAME seams the Linux unit gets: the same site
  selection, the same state dir, the same credential reference naming
  (gateclerk-SITE_LABEL-HOST, produced by gateclerk.config.credential_ref) and the same
  keep-alive semantics. No second configuration language, no second code path.

  Nothing installs it. tests/test_deploy_templates.py parses it with plistlib, checks it
  declares itself an EXAMPLE, checks it carries KeepAlive and ThrottleInterval matching the
  unit's Restart policy, and checks the credential block carries NAMES and no values.

  WHAT launchd CANNOT DO: systemd's LoadCredential= has no launchd equivalent.
  launchd's EnvironmentVariables are plaintext to anything that can read the job, so the
  secret is NOT stored in this file. Two honest options, both already supported by the
  resolver (gateclerk.config: flag, then env, then keychain):

    1. the macOS Keychain rung (preferred on a dev box):
         security add-generic-password -U -s gateclerk-hikvision -a HOST -j 'user=admin' -w
       no environment variable at all; the keychain ACCOUNT is the host (DESIGN.md);
    2. the env rung: the variable named in the credential block below, exported by your
       shell or a wrapper from a 0600 file, never written into this plist.

  Placeholders (substituted per site, exactly like the unit's angle-bracket tokens):
    SITE_LABEL   the site name (the instance argument; equals systemd's %i)
    STATE_DIR    where this site's sqlite store, park dir and logs live
    CONFIG_PATH  the sites.toml this job reads (refs only, never values)
    PYTHON_BIN   the python of the venv gateclerk was installed into
    plus the credential block between the gateclerk-credential-refs markers, which is
    rewritten with one line per device of the site.

  No real device host, address or credential appears in this file: HOST placeholders and
  RFC 5737 TEST-NET addresses only.

  Install on a dev box: render the tokens, save as
    com.gateclerk.agent.SITE_LABEL.plist in  ~/Library/LaunchAgents/
  then  launchctl load  ~/Library/LaunchAgents/com.gateclerk.agent.SITE_LABEL.plist
  and  launchctl list  | grep gateclerk  for the status and the last exit code.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- One job per site, named the way the systemd instance is named, so "gateclerk
       SITE_LABEL" stays the single identity an operator uses on either OS. -->
  <key>Label</key>
  <string>com.gateclerk.agent.SITE_LABEL</string>

  <!-- The same entry point the systemd unit runs, spelled out rather than wrapped.
       launchd relaunches the job itself, so there is no once flag here: the once form is
       the smoke test you run by hand (deploy/README.md step 3) before loading this job,
       because a once form under KeepAlive becomes a five second poll of a door
       controller. -->
  <key>ProgramArguments</key>
  <array>
    <string>PYTHON_BIN</string>
    <string>-m</string>
    <string>gateclerk.cli</string>
    <string>agent</string>
    <string>run</string>
    <string>--site</string>
    <string>SITE_LABEL</string>
    <string>--config</string>
    <string>CONFIG_PATH</string>
    <string>--state-root</string>
    <string>STATE_DIR</string>
  </array>

  <!-- Relative db_path values (and the derived gateclerk-SITE_LABEL.sqlite3) resolve here,
       exactly like the unit's WorkingDirectory. -->
  <key>WorkingDirectory</key>
  <string>STATE_DIR</string>

  <!-- launchd's KeepAlive is systemd's Restart=always: the job comes back when it dies,
       because a stopped agent means silent punch loss (OBSERVED.md: the device log ring
       rolls over). ThrottleInterval is launchd's floor and is set to the same 5 seconds as
       the unit's RestartSec: never hammer the device (spec section 1.9). The park state
       (P2-05) lives on DISK under the site's state dir precisely so a relaunch cannot
       present dead credentials to a lockout counting device: an unacked park still blocks
       every tick after launchd brings the process back, until "gateclerk agent ack". -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- Only non-secret environment here. The credential block below names devices and
       carries NO value: launchd has no LoadCredential=, so the value comes from the
       Keychain rung (preferred) or from the 0600 file that exports the env rung named
       there. This block is the only place a device is named in this file.

         gateclerk-credential-refs-begin
         credential reference  gateclerk-SITE_LABEL-HOST   env rung GATECLERK_HOST_PASSWORD
         (the reference is gateclerk.config.credential_ref(site, host); the env rung is
          gateclerk.config.env_var_names(host)[1], where every non-alphanumeric host
          character becomes an underscore; render one line per device of the site)
         gateclerk-credential-refs-end
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <!-- The agent's own clock is UTC everywhere (store stamps, park stamps). The SITE's
         zone is config data (iana_tz in sites.toml), never the process locale. -->
    <key>TZ</key>
    <string>UTC</string>
  </dict>

  <!-- stdout and stderr are the alert channel (P2-05's default sink is one stderr line per
       page: level, site label, kind, serial; never a host, never a payload, never an
       Authorization header). journald receives these on Linux; here they land in the
       site's state dir. -->
  <key>StandardOutPath</key>
  <string>STATE_DIR/logs/gateclerk-agent-SITE_LABEL.out.log</string>
  <key>StandardErrorPath</key>
  <string>STATE_DIR/logs/gateclerk-agent-SITE_LABEL.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
