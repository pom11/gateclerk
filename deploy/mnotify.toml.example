# deploy/mnotify.toml.example — copy to deploy/mnotify.toml, then mount it read-only.
#
# This is micro-notify's config, not gateclerk's. It carries no secret values: the
# certificate/secret/webhook material lives in MICRO_NOTIFY_SECRETS_DIR as one file
# per account. The image runs mnotify from a separate venv, as uid 10001, with a
# read-only root filesystem; [paths] below therefore point at the named volume that
# compose mounts at /var/lib/mnotify.
#
# Replace the GUIDs and the sender before use. Keep sender/allowlist consistent with
# the operator's tenant; the empty allowlist is not a working alert setup (mnotify
# refuses every recipient), it is only the safe placeholder.

[mail]
tenant_id = "00000000-0000-0000-0000-000000000000"
client_id = "00000000-0000-0000-0000-000000000000"
sender = "noreply@example.com"
auth = "certificate"
mode = "app"
default_reply_to = ""

[allow]
domains = ["example.com"]
addresses = []

[limits]
max_recipients = 20
daily_max = 200
max_attach_mb = 3

[paths]
audit = "/var/lib/mnotify/audit/sent.jsonl"
state_dir = "/var/lib/mnotify/state"

# Teams targets are optional. Add a target only after its webhook URL exists as a file
# in MICRO_NOTIFY_SECRETS_DIR; otherwise `mnotify doctor` fails the teams check.
#
# [teams.targets.alerts]
# kind = "channel"
