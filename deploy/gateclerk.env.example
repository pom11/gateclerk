# deploy/gateclerk.env.example — copy to deploy/gateclerk.env, fill in, chmod 0600.
#
# These are the EXACT env rungs the code reads; do not rename them.
# Device password: config.env_var_names(host) -> GATECLERK_<HOST-WITH-NON-ALNUM-AS-_>_PASSWORD
#   (host 192.0.2.10 -> GATECLERK_192_0_2_10_PASSWORD)
# Ingest bearer: agent_push.ingest_token_env_var(site) -> GATECLERK_INGEST_TOKEN_<SITE-UPPERCASE>
#   (site site-a -> GATECLERK_INGEST_TOKEN_SITE-A; the dash is kept)
#
# Values below are placeholders. Never commit the filled-in file.
GATECLERK_192_0_2_10_PASSWORD=<device-password>
GATECLERK_192_0_2_11_PASSWORD=<device-password>
GATECLERK_INGEST_TOKEN_SITE-A=<ingest-bearer-token>
GATECLERK_INGEST_TOKEN_SITE-B=<ingest-bearer-token>

# micro-notify is in the same image and is exec'd by gateclerk as a child process.
# These are PATHS, never values: the config file and the secret files are mounts.
# MICRO_NOTIFY_SECRETS_DIR is a directory of one file per account, not an env secret.
MICRO_NOTIFY_CONFIG=/etc/mnotify/config.toml
MICRO_NOTIFY_SECRETS=file
MICRO_NOTIFY_SECRETS_DIR=/run/secrets/mnotify
